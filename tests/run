#!/bin/bash
# Run every *-test.sh in this directory; keep going after a failing file.
set -uo pipefail

DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
failed=()
for test in "$DIR"/*-test.sh; do
  printf '==> %s\n' "$(basename "$test")"
  bash "$test" || failed+=("$(basename "$test")")
done

if ((${#failed[@]})); then
  printf '\nFAILED: %s\n' "${failed[*]}" >&2
  exit 1
fi
printf '\nall tests passed\n'
