#!/bin/bash
# omarchy:summary=Switch all monitors to AW slot N (global) or current monitor (local)
# omarchy:args=<slot 1-10>
#
# Switch to AW slot N, respecting the global/local toggle at runtime.
#
# GLOBAL MODE (workspace-global.lua flag present):
#   Calls omarchy-hyprland-workspace-global-switch N.
#   All monitors switch to their slot-N Hyprland workspace simultaneously.
#
# LOCAL MODE (flag absent):
#   Focuses raw Hyprland workspace N on the current monitor only.

# Call this plugin's own helpers by absolute path. They must NOT be looked up on
# PATH: Omarchy ships same-named helpers in /usr/share/omarchy/bin, and an older
# copy there would silently win. GWS_BIN overrides the directory (used by tests).
GWS_BIN="${GWS_BIN:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")}"

SLOT="${1:-}"
if [[ -z "$SLOT" || ! "$SLOT" =~ ^([1-9]|10)$ ]]; then
  echo "Usage: $0 <slot 1-10>" >&2
  exit 1
fi

GLOBAL_FLAG="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr/workspace-global.lua"

if [[ -f "$GLOBAL_FLAG" ]]; then
  exec "$GWS_BIN/omarchy-hyprland-workspace-global-switch" "$SLOT"
else
  # Use Lua dispatcher form (0.56.2+ required string form to be valid Lua)
  exec hyprctl dispatch "hl.dsp.focus({ workspace = \"$SLOT\" })"
fi
