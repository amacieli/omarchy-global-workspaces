#!/bin/bash
# omarchy:summary=Switch all monitors to the same workspace slot (global mode)
# omarchy:args=<slot-number>
# omarchy:hidden=true
#
# Global-mode switch to slot N.
#
# Normal path: ONE dispatch — focus base+N for the focused monitor. The
# workspace.active hook in workspace-global.lua then syncs every other monitor
# and returns focus to the originating monitor. Dispatching per monitor from
# here as well would re-trigger that hook on every step.
#
# Heal path: focusing a workspace that is already active emits no event, so
# monitors that were out of sync would stay that way. After the dispatch the
# monitor state is re-read; any monitor still on the wrong workspace is fixed by
# focusing THAT MONITOR first, then the workspace (focusing a workspace on an
# unfocused monitor steals focus, and an empty workspace is created on whichever
# monitor is focused). The originally focused monitor is restored last.
#
# Bases come from monitor-bases.json (keyed by monitor name, not Hyprland id).

SLOT="${1:-}"
if [[ -z "$SLOT" || ! "$SLOT" =~ ^([1-9]|10)$ ]]; then
  echo "Usage: $0 <slot 1-10>" >&2
  exit 1
fi

BASES_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/monitor-bases.json"

raw_fallback() {
  exec hyprctl dispatch "hl.dsp.focus({ workspace = \"$SLOT\" })"
}

[[ -f "$BASES_FILE" ]] || raw_fallback

python3 - "$BASES_FILE" "$SLOT" <<'PYEOF'
import json, subprocess, sys, time

bases_file, slot = sys.argv[1], int(sys.argv[2])


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True)


def dispatch(expr):
    return hyprctl("dispatch", expr).returncode == 0


def monitors():
    try:
        out = hyprctl("monitors", "-j")
        return json.loads(out.stdout) if out.returncode == 0 else None
    except Exception:
        return None


def raw():
    sys.exit(0 if dispatch('hl.dsp.focus({ workspace = "%d" })' % slot) else 1)


try:
    with open(bases_file) as f:
        bases = json.load(f)
except Exception:
    bases = {}

mons = monitors()
if not bases or not mons:
    raw()

focused = next((m["name"] for m in mons if m.get("focused")), None)
if focused is None or focused not in bases:
    raw()

errors = 0
if not dispatch('hl.dsp.focus({ workspace = "%d" })' % (bases[focused] + slot)):
    errors += 1

# Heal: re-read, fix any connected monitor still off its target slot.
time.sleep(0.05)
mons = monitors() or []
fixed = False
for m in mons:
    name = m["name"]
    if name == focused or name not in bases:
        continue
    target = bases[name] + slot
    if m.get("activeWorkspace", {}).get("id") == target:
        continue
    fixed = True
    if not (dispatch('hl.dsp.focus({ monitor = "%s" })' % name)
            and dispatch('hl.dsp.focus({ workspace = "%d" })' % target)):
        errors += 1
if fixed:
    dispatch('hl.dsp.focus({ monitor = "%s" })' % focused)

sys.exit(0 if errors == 0 else 1)
PYEOF
